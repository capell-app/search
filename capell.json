{
    "manifest-version": 3,
    "name": "capell-app/search",
    "slug": "search",
    "displayName": "Search",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Adds a header search button, matching pages as visitors type and a results page you can steer with synonyms, typo fixes and promoted results.",
    "product": {
        "group": "Capell Search & SEO",
        "tier": "premium",
        "bundle": "search-seo"
    },
    "namespace": "Capell\\Search",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/discovery-foundation",
            "capell-app/frontend"
        ],
        "supports": [
            "capell-app/seo-suite",
            "capell-app/site-discovery",
            "capell-app/url-manager"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\Search\\Providers\\SearchServiceProvider",
            "Capell\\Search\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": ["Capell\\Search\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\Search\\Providers\\SearchServiceProvider"],
        "admin": ["Capell\\Search\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "route",
            "class": "Capell\\Search\\Manifest\\SearchFrontendRouteContribution",
            "routes": [
                "capell-frontend.search",
                "capell-frontend.search.autocomplete",
                "capell-frontend.search.click"
            ],
            "surface": "frontend"
        },
        {
            "type": "agent-capability",
            "class": "Capell\\Search\\Manifest\\SearchAgentToolContribution",
            "providerBucket": "runtime",
            "context": "public",
            "surface": "frontend"
        },
        {
            "type": "model",
            "class": "Capell\\Search\\Manifest\\SearchLogModelContribution",
            "modelClass": "Capell\\Search\\Models\\SearchLog"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Search\\Manifest\\TopSearchesWidgetContribution",
            "widgetClass": "Capell\\Search\\Filament\\Widgets\\TopSearchesFilamentWidget"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Search\\Manifest\\TrendingSearchesWidgetContribution",
            "widgetClass": "Capell\\Search\\Filament\\Widgets\\TrendingSearchesFilamentWidget"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Search\\Manifest\\ZeroResultSearchesWidgetContribution",
            "widgetClass": "Capell\\Search\\Filament\\Widgets\\ZeroResultSearchesFilamentWidget"
        },
        {
            "type": "overview-stat",
            "class": "Capell\\Search\\Manifest\\SearchOverviewStatsContribution",
            "keys": [
                "overview-stat:search_overview",
                "overview-stat:search_overview.unique_queries",
                "overview-stat:search_overview.zero_result_rate"
            ]
        },
        {
            "type": "admin-page",
            "class": "Capell\\Search\\Manifest\\SearchSettingsPageContribution",
            "pageClass": "Capell\\Search\\Filament\\Pages\\SearchSettingsPage",
            "labelKey": "capell-search::settings.title",
            "settingsGroup": "search"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Search\\Manifest\\SearchLogPurgeScheduleContribution",
            "command": "search:purge",
            "frequency": "monthly"
        },
        {
            "type": "console-command",
            "class": "Capell\\Search\\Manifest\\SearchConsoleCommandsContribution",
            "commands": [
                "search:index",
                "search:flush",
                "search:purge",
                "capell:search:screenshot-fixture"
            ],
            "commandClasses": [
                "Capell\\Search\\Console\\Commands\\IndexSearchCommand",
                "Capell\\Search\\Console\\Commands\\FlushSearchCommand",
                "Capell\\Search\\Console\\Commands\\PurgeSearchLogsCommand",
                "Capell\\Search\\Console\\Commands\\SeedSearchScreenshotFixtureCommand"
            ]
        },
        {
            "type": "setting",
            "class": "Capell\\Search\\Manifest\\SearchSettingsContribution",
            "settingsClass": "Capell\\Search\\Settings\\SearchSettings",
            "settingsGroup": "search"
        },
        {
            "type": "health-check",
            "class": "Capell\\Search\\Manifest\\SearchHealthContribution",
            "checkClass": "Capell\\Search\\Health\\SearchHealthCheck"
        },
        {
            "type": "migration",
            "class": "Capell\\Search\\Manifest\\SearchMigrationsContribution",
            "migrationFiles": [
                "2026_05_10_190868_01_create_search_logs_table",
                "2026_05_21_000002_add_fulltext_index_to_search_database_table",
                "2026_07_12_000001_encrypt_search_log_pii",
                "2026_09_29_120000_remove_implicit_timestamp_updates_from_search",
                "2026_11_11_000001_add_search_reference_to_search_logs"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": ["search_logs"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "index": "search:index",
        "flush": "search:flush",
        "purge": "search:purge",
        "screenshotFixture": "capell:search:screenshot-fixture"
    },
    "actions": {
        "install": "Capell\\Search\\Actions\\InstallSearchPackageAction",
        "applySearchResultEnhancements": "Capell\\Search\\Actions\\ApplySearchResultEnhancementsAction",
        "buildTopClickedResultsQuery": "Capell\\Search\\Actions\\BuildTopClickedResultsQueryAction",
        "buildTopSearchesQuery": "Capell\\Search\\Actions\\BuildTopSearchesQueryAction",
        "buildTrendingSearchesQuery": "Capell\\Search\\Actions\\BuildTrendingSearchesQueryAction",
        "buildZeroResultSearchesQuery": "Capell\\Search\\Actions\\BuildZeroResultSearchesQueryAction",
        "createPromotedResultFromZeroResultSearch": "Capell\\Search\\Actions\\CreatePromotedResultFromZeroResultSearchAction",
        "createSynonymFromZeroResultSearch": "Capell\\Search\\Actions\\CreateSynonymFromZeroResultSearchAction",
        "flushScoutSearchSources": "Capell\\Search\\Actions\\FlushScoutSearchSourcesAction",
        "indexScoutSearchSources": "Capell\\Search\\Actions\\IndexScoutSearchSourcesAction",
        "normalizeSearchQuery": "Capell\\Search\\Actions\\NormalizeSearchQueryAction",
        "purgeSearchLogs": "Capell\\Search\\Actions\\PurgeSearchLogsAction",
        "recordSearch": "Capell\\Search\\Actions\\RecordSearchAction",
        "recordSearchResultClick": "Capell\\Search\\Actions\\RecordSearchResultClickAction",
        "resolveExpandedSearchQueries": "Capell\\Search\\Actions\\ResolveExpandedSearchQueriesAction",
        "resolvePromotedSearchResults": "Capell\\Search\\Actions\\ResolvePromotedSearchResultsAction",
        "runSearch": "Capell\\Search\\Actions\\RunSearchAction"
    },
    "settings": ["Capell\\Search\\Settings\\SearchSettings"],
    "permissions": [],
    "capabilities": [
        "search",
        "search-admin",
        "search-console",
        "search-frontend",
        "search-site-discovery-indexing"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "GET /search (capell-frontend.search)",
                "GET /search/autocomplete (capell-frontend.search.autocomplete)",
                "POST /search/click (capell-frontend.search.click)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [
                "POST /search/click (capell-frontend.search.click)"
            ],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /search (capell-frontend.search)",
                "GET /search/autocomplete (capell-frontend.search.autocomplete)",
                "POST /search/click (capell-frontend.search.click)"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\Search\\Models\\SearchLog::$clicked_result_url",
                "Capell\\Search\\Models\\SearchLog::$query"
            ],
            "hashedTokenFields": [
                "search_logs.clicked_result_hash",
                "search_logs.ip_hash",
                "search_logs.normalized_query_hash",
                "search_logs.user_agent_hash"
            ],
            "redactedOutputClasses": [
                "Capell\\Search\\Actions\\RecordSearchAction",
                "Capell\\Search\\Actions\\RedactSearchQueryAction"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        },
        "manual": {
            "description": "Declared, unverified: these routes check their signature or token inside their own code. The declaration is reviewed in the Capell packages repository; it is not verified from the route middleware and never counts as a signed or tokenized route.",
            "tokenizedRoutes": [
                "POST /search/click (capell-frontend.search.click)"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["search"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "search.frontend-query",
            "label": "Frontend search normalises queries and returns paginated results.",
            "class": "Capell\\Search\\Health\\SearchHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "search.database-driver",
            "label": "Database search escapes wildcards and clamps pagination arguments.",
            "class": "Capell\\Search\\Health\\SearchHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "search.logging",
            "label": "Search logs capture query, result, and zero-result analytics.",
            "class": "Capell\\Search\\Health\\SearchHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "search.retention",
            "label": "Search log purge command enforces retention windows.",
            "class": "Capell\\Search\\Health\\SearchHealthCheck",
            "severity": "warning",
            "surface": "console"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Visitors land on the page they wanted, and you learn what they searched for and didn't find.",
        "description": "Visitors get a results page with the matching words highlighted and, if your theme uses the header from the Navigation package, a header button that opens a box showing matching pages as they type. You set synonyms, typo fixes and promoted pages, and administrators see top, trending and zero-result searches on the admin dashboard.",
        "problem": "Visitors can't find our pricing page and email me instead. I never see what they typed.",
        "outcome": "Searching \"tee\" can put your T-shirt page first, and the dashboard lists the searches that found nothing.",
        "faq": [
            {
                "question": "Do I have to build a search index?",
                "answer": "No. Search reads the list of your public pages that Discovery Foundation keeps, so an edit shows on the next search."
            },
            {
                "question": "Will it find text far down a long page?",
                "answer": "No. It matches the title, the address and the first 1000 characters of page text as plain text, so anything further down a long page isn't found."
            },
            {
                "question": "Can I hide the search button but keep search?",
                "answer": "Yes. Turn off Show header search to hide only the button, or turn off Enable search to remove search from the site altogether, including the results page. The button also needs a theme that uses the Navigation header."
            },
            {
                "question": "Does Search keep what visitors type?",
                "answer": "Searches made on the results page are logged with the query encrypted, unless the browser sends a Do Not Track or Global Privacy Control signal. Logs are kept for 180 days by default, and a monthly clean-up needs Laravel's scheduler running."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card titled Search with a light and a dark site page, both nearly empty, beside Index, Query and Curate.",
                "caption": "The Marketplace card for Search, which adds site search you can tune with synonyms and promoted results."
            },
            {
                "path": "docs/screenshots/search-curation-annotated.png",
                "alt": "Search settings with a synonym mapping tee to T-shirt, typo corrections, a promoted results button and a Submit button.",
                "caption": "Set synonyms, typo fixes and promoted results here to steer what visitors find."
            },
            {
                "path": "docs/screenshots/frontend-search-results-page.png",
                "alt": "Search results page for Capell publishing guide with 23 results as cards, the first one highlighted, and page numbers.",
                "caption": "Results come as cards with page numbers, and the first match has its title highlighted.",
                "required": true
            },
            {
                "path": "docs/screenshots/top-searches-widget.png",
                "alt": "Search insights panel headed Top searches with five queries, how many times each was searched and how many results it found.",
                "caption": "See what visitors search for most and how many results each search found."
            },
            {
                "path": "docs/screenshots/top-searches-widget-dark.png",
                "alt": "The same Top searches panel in the dark theme with five queries, their search counts and result counts.",
                "caption": "The Top searches panel for admins who use the dark theme."
            }
        ],
        "categories": ["admin", "console", "frontend", "search-seo"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "render-hook",
                "key": "header-search",
                "providerBucket": "runtime"
            }
        ]
    }
}
